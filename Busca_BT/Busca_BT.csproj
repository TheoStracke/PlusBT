<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<Authors>Theo Stracke</Authors>
		<Company>TS Builds</Company>
		<Product>BarTender Plus</Product>
		<PackageIcon>favicon.ico</PackageIcon>
		<ApplicationIcon>favicon.ico</ApplicationIcon>
		<Copyright>EULA</Copyright>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embutido no .exe: o app funciona sozinho, sem precisar desse arquivo solto
         ao lado do executável. Se alguém colocar um appsettings.json de verdade na
         mesma pasta do .exe, ele ainda é lido e tem prioridade sobre o embutido
         (útil pra customizar a conexão/log por máquina sem recompilar). -->
    <EmbeddedResource Include="appsettings.json">
      <LogicalName>Busca_BT.appsettings.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.*" />
		<PackageReference Include="Dapper" Version="2.1.*" />
		<PackageReference Include="ClosedXML" Version="0.102.*" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.*" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.*" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.*" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.*" />
		<PackageReference Include="WPF-UI" Version="4.3.0" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="favicon.ico">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </Resource>
	  <Resource Include="BT+.png" />
	  <!-- Splash nativa do WPF (aberta no construtor do App): imagem estática exibida no
	       instante do clique no .exe, antes do .NET terminar de carregar. É a mesma arte
	       da SplashWindow (sem o anel), que assume em seguida com a animação.
	       Regerar se mudar o visual da SplashWindow. -->
	  <Resource Include="splash.png" />
	</ItemGroup>

</Project>
