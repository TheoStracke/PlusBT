<UserControl x:Class="Busca_BT.HistoricoWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Histórico de Importações"
                   FontSize="24" FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ui:DataGrid x:Name="GridHistorico"
                         ItemsSource="{Binding Batches}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         GridLinesVisibility="Horizontal">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ARQUIVO"
                                        Binding="{Binding FileName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="DATA"
                                        Binding="{Binding ImportedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                        Width="160"/>
                    <DataGridTextColumn Header="IMPORTADOS"
                                        Binding="{Binding ImportedRows}"
                                        Width="120"/>
                    <DataGridTextColumn Header="IGNORADOS"
                                        Binding="{Binding SkippedRows}"
                                        Width="120"/>
                    <DataGridTemplateColumn Header="AÇÃO" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Content="Excluir"
                                           Appearance="Danger"
                                           Padding="10,4"
                                           Command="{Binding DataContext.DeleteBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           IsEnabled="{Binding Converter={StaticResource NotNullToBoolConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </ui:DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <ui:Button Content="Anterior" Appearance="Secondary"
                       Icon="{ui:SymbolIcon ArrowLeft24}"
                       Command="{Binding PreviousPageCommand}" Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding PageDisplay}"/>
            <ui:Button Content="Próxima" Appearance="Secondary"
                       Icon="{ui:SymbolIcon ArrowRight24}"
                       Command="{Binding NextPageCommand}" Margin="8,0"/>
            <ui:Button Content="Fechar" Appearance="Transparent"
                       Command="{Binding CloseCommand}" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
