<UserControl x:Class="Busca_BT.TemplateUpdateWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Barra de busca -->
            <RowDefinition Height="*"/>     <!-- Grid de templates -->
            <RowDefinition Height="Auto"/>  <!-- Footer / ações -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ────────────────────────────────────────────────────── -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Left"
                       Text="Gerenciamento de Etiquetas"
                       FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="Sincronizar pasta"
                           ToolTip="Copia os .btw para a pasta centralizada e atualiza o banco"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Appearance="Primary"
                           Margin="0,0,8,0"
                           Command="{Binding SyncNewFolderCommand}"/>
                <ui:Button Content="Importar pasta"
                           ToolTip="Associa os .btw de uma pasta sem copiar os arquivos"
                           Icon="{ui:SymbolIcon FolderArrowUp24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Command="{Binding ImportFolderCommand}"/>
                <ui:Button Content="Importar arquivo"
                           Icon="{ui:SymbolIcon DocumentArrowUp24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Command="{Binding AddSingleTemplateCommand}"/>
                <ui:Button Content="Fechar"
                           Appearance="Transparent"
                           Command="{Binding CloseCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- ── BARRA DE BUSCA ─────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" MaxWidth="480" HorizontalAlignment="Left"
                        PlaceholderText="Buscar por código, descrição ou arquivo…"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       FontSize="12"
                       Opacity="0.65">
                <Run Text="{Binding Templates.Count, Mode=OneWay}"/>
                <Run Text=" resultado(s)"/>
            </TextBlock>
        </Grid>

        <!-- ── GRID DE TEMPLATES ──────────────────────────────────────────── -->
        <Border Grid.Row="2" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ui:DataGrid x:Name="GridTemplates"
                         ItemsSource="{Binding Templates}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         GridLinesVisibility="Horizontal"
                         MouseDoubleClick="GridTemplates_MouseDoubleClick">

                <DataGrid.Columns>

                    <!-- 1. CÓDIGO -->
                    <DataGridTemplateColumn Header="CÓDIGO" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Codigo}" VerticalAlignment="Center" Margin="12,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 2. DESCRIÇÃO -->
                    <DataGridTemplateColumn Header="DESCRIÇÃO" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DescricaoAnvisa}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 3. ARQUIVO .BTW -->
                    <DataGridTemplateColumn Header="ARQUIVO .BTW" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NomeArquivo}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 4. ÚLTIMA ATUALIZAÇÃO -->
                    <DataGridTemplateColumn Header="ÚLTIMA ATUALIZAÇÃO" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UpdatedAtFormatado}" VerticalAlignment="Center" Margin="12,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 5. STATUS COLORIDO -->
                    <DataGridTemplateColumn Header="STATUS" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusTexto}"
                                           Foreground="{Binding StatusCor}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 6. BOTÃO DE AÇÃO RÁPIDA -->
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Content="Abrir"
                                           Visibility="{Binding TemArquivo, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Appearance="Secondary"
                                           Padding="10,4"
                                           Tag="{Binding}"
                                           Click="BtnAbrirRow_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </ui:DataGrid>
        </Border>

        <!-- ── FOOTER ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="STATUS" FontSize="10" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,3"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" MaxWidth="500"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Content="Salvar / substituir arquivo"
                           ToolTip="Escolhe um novo .btw e substitui o arquivo associado ao item selecionado"
                           Icon="{ui:SymbolIcon Save24}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Command="{Binding SaveLabelCommand}"/>
                <ui:Button Content="Abrir etiqueta"
                           ToolTip="Abre o .btw no BarTender para edição (duplo clique na linha também funciona)"
                           Icon="{ui:SymbolIcon Open24}"
                           Appearance="Primary"
                           Command="{Binding OpenLabelCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Overlay de carregamento -->
        <Grid Grid.RowSpan="4"
              Background="#80000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,12"/>
                <TextBlock Text="Aguarde…" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
