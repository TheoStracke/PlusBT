<UserControl x:Class="Busca_BT.TemplateUpdateWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Aviso modo pasta -->
            <RowDefinition Height="Auto"/>  <!-- Busca -->
            <RowDefinition Height="*"/>     <!-- Lista + detalhe -->
            <RowDefinition Height="Auto"/>  <!-- Status -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ───────────────────────────────────────────────────── -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Acervo de templates" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Resumo}" FontSize="12" Opacity="0.65" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Content="Adicionar arquivos"
                           ToolTip="Envia um ou mais .btw ao acervo. Código novo vira template novo; código existente vira nova versão."
                           Icon="{ui:SymbolIcon DocumentArrowUp20}" Appearance="Primary" Margin="0,0,8,0"
                           Command="{Binding AdicionarArquivosCommand}"/>
                <ui:Button Content="Importar pasta"
                           ToolTip="Envia todos os .btw de uma pasta (e subpastas). Arquivos iguais aos do acervo são ignorados."
                           Icon="{ui:SymbolIcon FolderArrowUp24}" Appearance="Secondary" Margin="0,0,8,0"
                           Command="{Binding ImportarPastaCommand}"/>
                <ui:Button Content="Exportar acervo"
                           ToolTip="Copia a versão atual de todos os templates para uma pasta (backup ou modo Pasta local)."
                           Icon="{ui:SymbolIcon FolderArrowRight24}" Appearance="Secondary" Margin="0,0,8,0"
                           Command="{Binding ExportarCommand}"/>
                <ui:Button ToolTip="Sincronizar agora" Icon="{ui:SymbolIcon ArrowSync20}" Appearance="Transparent"
                           Command="{Binding SincronizarCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- ── AVISO: PC no modo Pasta local ───────────────────────────── -->
        <Border Grid.Row="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding ModoPastaLocal, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning20" Filled="True" Margin="0,0,10,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                <TextBlock Text="{Binding AvisoModoPasta}" TextWrapping="Wrap" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- ── BUSCA ───────────────────────────────────────────────────── -->
        <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="False">
            <ui:TextBox DockPanel.Dock="Left" Width="380"
                        PlaceholderText="Buscar por código ou nome do arquivo…"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                      Content="Só alterados neste PC" IsChecked="{Binding SomenteAlterados}"/>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Opacity="0.6"
                       ToolTip="Cópia local do acervo neste PC: as etiquetas abrem daqui">
                <Run Text="Pasta local: "/><Run Text="{Binding PastaLocal, Mode=OneWay}"/>
            </TextBlock>
        </DockPanel>

        <!-- ── LISTA + DETALHE ─────────────────────────────────────────── -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <ui:DataGrid x:Name="GridTemplates"
                             ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                             SelectionMode="Single" GridLinesVisibility="Horizontal"
                             EnableRowVirtualization="True"
                             MouseDoubleClick="GridTemplates_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="140"/>
                        <DataGridTextColumn Header="ARQUIVO" Binding="{Binding NomeArquivo}" Width="*"/>
                        <DataGridTextColumn Header="VERSÃO" Binding="{Binding VersaoTexto}" Width="80"/>
                        <DataGridTextColumn Header="ATUALIZADO" Binding="{Binding AtualizadoTexto}" Width="190"/>
                        <DataGridTemplateColumn Header="NESTE PC" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusTexto}" Foreground="{Binding StatusCor}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </ui:DataGrid>
            </Border>

            <!-- Detalhe do selecionado -->
            <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <Grid>
                    <!-- Nada selecionado -->
                    <TextBlock Text="Selecione um template para ver as ações e as versões guardadas."
                               TextWrapping="Wrap" Opacity="0.65" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DockPanel Visibility="{Binding Selected, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding Selected.Codigo}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock FontSize="12" Opacity="0.65" Margin="0,2,0,12">
                                <Run Text="{Binding Selected.VersaoTexto, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Selected.StatusTexto, Mode=OneWay}"/>
                            </TextBlock>

                            <ui:Button Content="Abrir no BarTender" Icon="{ui:SymbolIcon Open20}" Appearance="Secondary"
                                       HorizontalAlignment="Stretch" Margin="0,0,0,8" Command="{Binding AbrirCommand}"/>
                            <ui:Button Content="Enviar alteração" Icon="{ui:SymbolIcon CloudArrowUp20}" Appearance="Primary"
                                       HorizontalAlignment="Stretch" Margin="0,0,0,8" Command="{Binding EnviarAlteracaoCommand}"
                                       ToolTip="Envia o arquivo editado neste PC como nova versão do acervo"/>
                            <ui:Button Content="Enviar outro arquivo como nova versão…" Icon="{ui:SymbolIcon DocumentArrowUp20}"
                                       Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,0,0,16"
                                       Command="{Binding EnviarNovaVersaoCommand}"/>

                            <TextBlock Text="VERSÕES GUARDADAS" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,6"/>
                            <TextBlock Text="A atual e as 3 anteriores ficam guardadas. Restaurar cria uma versão nova."
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding VersoesMensagem}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Versoes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" Padding="0,8"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                            <DockPanel>
                                                <ui:Button DockPanel.Dock="Right" Content="Restaurar" Appearance="Transparent"
                                                           Padding="8,4" VerticalAlignment="Center"
                                                           Command="{Binding DataContext.RestaurarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"/>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" FontSize="13">
                                                        <Run Text="v"/><Run Text="{Binding Versao, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Resumo}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- ── STATUS ──────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Overlay de trabalho -->
        <Grid Grid.RowSpan="5" Background="#80000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
