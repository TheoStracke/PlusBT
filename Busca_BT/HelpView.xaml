<UserControl x:Class="Busca_BT.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             FontFamily="Segoe UI">
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header/Title Row -->
        <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                   Text="AJUDA E SUPORTE"
                   FontSize="24" FontWeight="Bold" Foreground="#0F172A"
                   Margin="0,0,0,32"/>

        <!-- Left Column: System Information -->
        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,32,0">
            <TextBlock Text="INFORMAÇÕES DO SISTEMA"
                       FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"
                       Margin="0,0,0,16"/>

            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Nome do Software"
                               FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Gestão de Etiquetas BarTender"
                               FontSize="14" Foreground="#1E293B"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Versão"
                               FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="1.0.0"
                               FontSize="14" Foreground="#1E293B"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Propósito"
                               FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Sistema de gerenciamento e sincronização de templates de etiquetas BarTender com banco de dados SQL. Facilita a importação, atualização e organização de etiquetas para impressão e distribuição."
                               FontSize="13" Foreground="#334155"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="0,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right Column: Support Information -->
        <StackPanel Grid.Column="1" Grid.Row="1" Margin="32,0,0,0">
            <TextBlock Text="SUPORTE TÉCNICO"
                       FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"
                       Margin="0,0,0,16"/>

            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Desenvolvedor"
                               FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Theo Cardoso Stracke"
                               FontSize="14" Foreground="#1E293B"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Contato"
                               FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                               Margin="0,0,0,6"/>

                    <!-- Email Link -->
                    <Button Content="📧 theostracke11@gmail.com"
                            Background="Transparent"
                            Foreground="#2563EB"
                            BorderThickness="0"
                            Padding="0,4"
                            HorizontalAlignment="Left"
                            FontSize="13"
                            Cursor="Hand"
                            Command="{Binding OpenEmailCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextDecorations="Underline"
                                           Cursor="Hand"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- GitHub Link -->
                    <Button Content="🔗 github.com/theostracke"
                            Background="Transparent"
                            Foreground="#2563EB"
                            BorderThickness="0"
                            Padding="0,4"
                            HorizontalAlignment="Left"
                            FontSize="13"
                            Cursor="Hand"
                            Command="{Binding OpenGitHubCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextDecorations="Underline"
                                           Cursor="Hand"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Margin="0,20,0,16"/>

                    <!-- Support Button -->
                    <Button Content="SOLICITAR SUPORTE"
                            Width="200" Height="44"
                            Background="#059669"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            FontSize="13"
                            Cursor="Hand"
                            Command="{Binding OpenWhatsAppCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#047857"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#065F46"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="Disponível via WhatsApp ou Email"
                               FontSize="11" Foreground="#64748B"
                               FontStyle="Italic"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Close Button -->
            <Button Content="FECHAR"
                    Width="120" Height="40"
                    Background="Transparent"
                    Foreground="#334155"
                    BorderBrush="#94A3B8"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Command="{Binding CloseCommand}"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Left">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
