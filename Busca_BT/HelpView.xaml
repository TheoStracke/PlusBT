<UserControl x:Class="Busca_BT.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header/Title Row -->
        <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Ajuda e suporte"
                   FontSize="24" FontWeight="SemiBold"
                   Margin="0,0,0,24"/>

        <!-- Left Column: System Information -->
        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,16,0">
            <TextBlock Text="INFORMAÇÕES DO SISTEMA"
                       FontSize="13" FontWeight="SemiBold" Opacity="0.7"
                       Margin="0,0,0,12"/>

            <ui:Card Padding="20">
                <StackPanel>
                    <TextBlock Text="Nome do Software" FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,4"/>
                    <TextBlock Text="Gestão de Etiquetas BarTender" FontSize="14" Margin="0,0,0,18"/>

                    <TextBlock Text="Versão" FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,4"/>
                    <TextBlock Text="1.0.0" FontSize="14" Margin="0,0,0,18"/>

                    <TextBlock Text="Propósito" FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,4"/>
                    <TextBlock Text="Sistema de gerenciamento e sincronização de templates de etiquetas BarTender com banco de dados SQL. Facilita a importação, atualização e organização de etiquetas para impressão e distribuição."
                               FontSize="13" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </ui:Card>
        </StackPanel>

        <!-- Right Column: Support Information -->
        <StackPanel Grid.Column="1" Grid.Row="1" Margin="16,0,0,0">
            <TextBlock Text="SUPORTE TÉCNICO"
                       FontSize="13" FontWeight="SemiBold" Opacity="0.7"
                       Margin="0,0,0,12"/>

            <ui:Card Padding="20">
                <StackPanel>
                    <TextBlock Text="Desenvolvedor" FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,4"/>
                    <TextBlock Text="Theo Cardoso Stracke" FontSize="14" Margin="0,0,0,18"/>

                    <TextBlock Text="Contato" FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,8"/>

                    <ui:HyperlinkButton Content="theostracke11@gmail.com"
                                        Icon="{ui:SymbolIcon Mail24}"
                                        Command="{Binding OpenEmailCommand}"
                                        Padding="0,4" Margin="0,0,0,4"/>

                    <ui:HyperlinkButton Content="github.com/theostracke"
                                        Icon="{ui:SymbolIcon Link24}"
                                        Command="{Binding OpenGitHubCommand}"
                                        Padding="0,4" Margin="0,0,0,16"/>

                    <ui:Button Content="Solicitar suporte"
                               Icon="{ui:SymbolIcon ChatHelp24}"
                               Appearance="Success"
                               HorizontalAlignment="Left"
                               Command="{Binding OpenWhatsAppCommand}"/>

                    <TextBlock Text="Disponível via WhatsApp ou Email"
                               FontSize="11" Opacity="0.6" FontStyle="Italic"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </ui:Card>

            <ui:Button Content="Fechar"
                       Appearance="Transparent"
                       HorizontalAlignment="Left"
                       Command="{Binding CloseCommand}"
                       Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
