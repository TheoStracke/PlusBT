<UserControl x:Class="Busca_BT.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <!-- ══ CONTEÚDO ═══════════════════════════════════════════════════ -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title + import -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left" Text="Lista de Invoices"
                           FontSize="24" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="Limpar fila"
                               Icon="{ui:SymbolIcon Delete20}"
                               Appearance="Secondary"
                               Margin="0,0,8,0"
                               ToolTip="Remove todas as etiquetas da fila atual"
                               Command="{Binding AskClearQueueCommand}"/>
                    <ui:Button Content="Importar planilha"
                               Icon="{ui:SymbolIcon DocumentArrowUp20}"
                               Appearance="Primary"
                               Command="{Binding ImportCommand}"/>
                </StackPanel>
            </DockPanel>

            <!-- Busca -->
            <ui:TextBox Grid.Row="1" Width="380" HorizontalAlignment="Left" Margin="0,0,0,16"
                        PlaceholderText="Buscar por invoice, código, lote, LPN ou descrição..."
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Stat cards -->
            <UniformGrid Grid.Row="2" Columns="5" Margin="0,0,0,16">
                <ui:Card Margin="0,0,8,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="TOTAL" Opacity="0.65" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatTotal}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,8,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="VINCULADOS" Opacity="0.65" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatVinculados}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,8,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="SEM ARQUIVO" Opacity="0.65" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatSemArquivo}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,8,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="IMPORTAÇÕES" Opacity="0.65" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatImportacoes}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="14">
                    <StackPanel>
                        <TextBlock Text="FOLHAS DE ESPELHO" Opacity="0.65" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatFolhas}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding StatInvoices}" FontSize="11" Opacity="0.65" Margin="0,2,0,0"/>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Invoices: uma linha por invoice; clicar expande a fila de rótulos -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Invoices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel>

                                    <!-- Cabeçalho clicável da invoice -->
                                    <Border CornerRadius="8" Padding="16,12" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Seta: aponta para baixo quando a fila está aberta -->
                                            <ui:SymbolIcon Grid.Column="0" FontSize="16"
                                                           Margin="0,0,14,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="{x:Type ui:SymbolIcon}">
                                                        <Setter Property="Symbol" Value="ChevronRight20"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Symbol" Value="ChevronDown20"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="15">
                                                    <Run Text="Invoice " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <Run Text="{Binding Invoice, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ResumoTexto}" FontSize="12" Opacity="0.65" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Progresso: rótulos já abertos / total -->
                                            <ProgressBar Grid.Column="2" Height="6" Maximum="100"
                                                         VerticalAlignment="Center"
                                                         Value="{Binding Progresso, Mode=OneWay}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Concluida}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>

                                            <TextBlock Grid.Column="3" Text="{Binding ProgressoTexto}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                            <ui:SymbolIcon Grid.Column="4" Symbol="CheckmarkCircle20" Filled="True" FontSize="18"
                                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           ToolTip="Todos os rótulos desta invoice já foram abertos"
                                                           Visibility="{Binding Concluida, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Fila de rótulos da invoice -->
                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border BorderThickness="0,1,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                Padding="16,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Item" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                                <TextBlock Grid.Column="1" Text="Código" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                                <TextBlock Grid.Column="2" Text="Descrição ANVISA" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                                <TextBlock Grid.Column="3" Text="Lote" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                                <TextBlock Grid.Column="4" Text="LPN" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                                <TextBlock Grid.Column="5" Text="Ação" FontSize="12" FontWeight="SemiBold" Opacity="0.7"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="16,6" BorderThickness="0,0,0,1"
                                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FoiAberta}" Value="True">
                                                                        <Setter Property="Background" Value="#FFF4CE"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="100"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Item}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Codigo}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding DescricaoAnvisa}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                                                       ToolTip="{Binding DescricaoAnvisa}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Lote}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding Lpn}" VerticalAlignment="Center"/>
                                                            <ui:Button Grid.Column="5" MinWidth="80"
                                                                       Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}">
                                                                <ui:Button.Style>
                                                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                                        <Setter Property="Content" Value="Abrir"/>
                                                                        <Setter Property="Appearance" Value="Secondary"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding FoiAberta}" Value="True">
                                                                                <Setter Property="Content" Value="Aberto"/>
                                                                                <Setter Property="Appearance" Value="Success"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:Button.Style>
                                                            </ui:Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Fila vazia -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFila}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon Symbol="DocumentArrowUp20" FontSize="40" Opacity="0.4" HorizontalAlignment="Center"/>
                <TextBlock Text="A fila está vazia" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Importe uma planilha para montar a fila de rótulos." FontSize="12" Opacity="0.65"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ══ OVERLAY DE IMPORTAÇÃO ═════════════════════════════════════
             Processando (spinner) → Sucesso (check verde animado) → Resumo (modal) -->
        <Grid Background="{DynamicResource SmokeFillColorDefaultBrush}"
              Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}">

            <!-- 1. Processando -->
            <Border Width="260" Padding="32" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="56" Height="56" Margin="0,0,0,16"/>
                    <TextBlock Text="Importando planilha…" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 2. Sucesso: check verde redondo animado -->
            <Border Width="300" Padding="32,36" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding IsSuccessAnimation, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="140" Height="140" HorizontalAlignment="Center">

                        <!-- Onda que expande e some -->
                        <Ellipse Width="112" Height="112" StrokeThickness="3"
                                 Stroke="{DynamicResource SystemFillColorSuccessBrush}"
                                 Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccessAnimation}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard BeginTime="0:0:0.25">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0.9" To="1.3" Duration="0:0:0.8"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.9" To="1.3" Duration="0:0:0.8"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.7" To="0" Duration="0:0:0.8"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <!-- Círculo verde com o check -->
                        <Grid Width="112" Height="112" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="0" ScaleY="0"/>
                            </Grid.RenderTransform>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccessAnimation}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0" To="1" Duration="0:0:0.45">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase EasingMode="EaseOut" Amplitude="0.45"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0" To="1" Duration="0:0:0.45">
                                                            <DoubleAnimation.EasingFunction>
                                                                <BackEase EasingMode="EaseOut" Amplitude="0.45"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Ellipse Fill="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <ui:SymbolIcon Symbol="Checkmark48" FontSize="64" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <TextBlock Text="Planilha importada" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,0" Opacity="0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessAnimation}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard BeginTime="0:0:0.3">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.35"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 3. Modal de resumo -->
            <Border DataContext="{Binding Summary}"
                    Width="620" MaxHeight="600" CornerRadius="12" Padding="28,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding DataContext.IsSummaryOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsSummaryOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="16" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CheckmarkCircle48" Filled="True" FontSize="44"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                           Visibility="{Binding Success, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <ui:SymbolIcon Symbol="DismissCircle48" Filled="True" FontSize="44"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding Failed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FileName}" FontSize="12" Opacity="0.65" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- Mensagem de falha geral -->
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="13"
                                       Margin="0,0,0,16"
                                       Visibility="{Binding Failed, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Importados (verde) -->
                            <Border CornerRadius="8" Padding="16,14" Margin="0,0,0,12"
                                    Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                    Visibility="{Binding HasImportados, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Filled="True" FontSize="22"
                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding ImportadosTexto}" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Importados}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="32,3,0,3">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding QuantidadeTexto}"
                                                               FontSize="12" Opacity="0.7"/>
                                                    <TextBlock FontSize="13">
                                                        <Run Text="Invoice " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <Run Text="{Binding Invoice, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Não importados (vermelho) -->
                            <Border CornerRadius="8" Padding="16,14"
                                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                    Visibility="{Binding HasNaoImportados, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ui:SymbolIcon Symbol="DismissCircle24" Filled="True" FontSize="22"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding NaoImportadosTexto}" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding NaoImportados}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="32,3,0,5">
                                                    <TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Motivo}" FontSize="12" Opacity="0.75"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Rodapé: relatórios gerados + ações -->
                    <DockPanel Grid.Row="2" Margin="0,20,0,0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="Abrir pasta" Appearance="Secondary"
                                       Icon="{ui:SymbolIcon FolderOpen20}" Margin="0,0,8,0"
                                       Visibility="{Binding HasRelatorio, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Command="{Binding DataContext.OpenReportFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <ui:Button Content="Fechar" Appearance="Primary" MinWidth="120"
                                       Command="{Binding DataContext.CloseSummaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>

                        <!-- Relatórios salvos -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                    Visibility="{Binding HasRelatorio, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="{Binding RelatorioPasta}">
                            <ui:SymbolIcon Symbol="DocumentTable24" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding RelatorioTexto}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Relatórios PlusBT" FontSize="11" Opacity="0.65"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Falha ao salvar os relatórios -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                    Visibility="{Binding HasRelatorioErro, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:SymbolIcon Symbol="ErrorCircle24" Filled="True" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                            <TextBlock Text="{Binding RelatorioErro}" FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center" MaxWidth="340"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 4. Confirmação de "Limpar fila" -->
            <Border Width="460" CornerRadius="12" Padding="28,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding IsConfirmClearOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
                            <ui:SymbolIcon Symbol="Delete24" FontSize="22"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Limpar a fila?" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="{Binding ConfirmClearTexto}" FontSize="13" TextWrapping="Wrap" Opacity="0.85"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                         Visibility="{Binding IsClearing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ui:Button Content="Cancelar" Appearance="Secondary" MinWidth="100" Margin="0,0,8,0"
                                   Command="{Binding CancelClearQueueCommand}"/>
                        <ui:Button Content="Limpar fila" Appearance="Danger" MinWidth="120"
                                   Icon="{ui:SymbolIcon Delete20}"
                                   Command="{Binding ConfirmClearQueueCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
