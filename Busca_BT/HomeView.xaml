<UserControl x:Class="Busca_BT.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sync notification banner -->
        <Grid Grid.Row="0" Margin="0,0,0,16"
              Visibility="{Binding TemAtualizacaoPendente, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:InfoBar Grid.Column="0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="Atualização disponível"
                        Message="Há novos templates disponíveis no servidor."/>
            <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                       Content="Atualizar lista"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding SyncCommand}"/>
        </Grid>

        <!-- Title + import -->
        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Left" Text="Lista de Invoices"
                       FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <ui:Button DockPanel.Dock="Right"
                       Content="Importar planilha"
                       Icon="{ui:SymbolIcon DocumentArrowUp20}"
                       Appearance="Primary"
                       Command="{Binding ImportCommand}"/>
        </DockPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <ComboBox ItemsSource="{Binding Batches}" Width="300" Margin="0,0,8,0"
                      SelectedItem="{Binding SelectedBatch}" DisplayMemberPath="Label"/>
            <ui:TextBox Width="380"
                        PlaceholderText="Buscar por invoice, código, lote, LPN ou descrição..."
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Stat cards -->
        <UniformGrid Grid.Row="3" Columns="5" Margin="0,0,0,16">
            <ui:Card Margin="0,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="TOTAL" Opacity="0.65" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatTotal}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="0,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="VINCULADOS" Opacity="0.65" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatVinculados}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="0,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="SEM ARQUIVO" Opacity="0.65" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatSemArquivo}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="0,0,8,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="IMPORTAÇÕES" Opacity="0.65" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatImportacoes}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </ui:Card>
            <ui:Card Padding="14">
                <StackPanel>
                    <TextBlock Text="FOLHAS DE ESPELHO" Opacity="0.65" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatFolhas}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <TextBlock FontSize="11" Opacity="0.65" Margin="0,2,0,0">
                        <Run Text="{Binding StatEtiquetas, Mode=OneWay}"/>
                        <Run Text=" etiquetas no lote"/>
                    </TextBlock>
                </StackPanel>
            </ui:Card>
        </UniformGrid>

        <!-- Grid -->
        <Border Grid.Row="4" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ui:DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FoiAberta}" Value="True">
                                <Setter Property="Background" Value="#FFF4CE"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="60" />
                    <DataGridTextColumn Header="Invoice" Binding="{Binding Invoice}" Width="150" />
                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100" />
                    <DataGridTextColumn Header="Descrição ANVISA" Binding="{Binding DescricaoAnvisa}" Width="*" />
                    <DataGridTextColumn Header="Lote" Binding="{Binding Lote}" Width="120" />
                    <DataGridTextColumn Header="LPN" Binding="{Binding Lpn}" Width="150" />
                    <DataGridTemplateColumn Header="Ação" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Content="Abrir"
                                           Appearance="Secondary"
                                           Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}">
                                    <ui:Button.Style>
                                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FoiAberta}" Value="True">
                                                    <Setter Property="Content" Value="Aberto"/>
                                                    <Setter Property="Appearance" Value="Success"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </ui:DataGrid>
        </Border>
    </Grid>
</UserControl>
