<UserControl x:Class="Busca_BT.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF" FontFamily="Segoe UI">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Sync notification banner -->
		<Border Grid.Row="0"
                Background="#1e293b"
                CornerRadius="0"
                Padding="16,12"
                Margin="0,0,0,12"
                Visibility="{Binding TemAtualizacaoPendente, Converter={StaticResource BooleanToVisibilityConverter}}">
			<DockPanel LastChildFill="True">
				<Button DockPanel.Dock="Right"
                        Content="ATUALIZAR LISTA"
                        Width="140" Height="32"
                        Margin="12,0,0,0"
                        Foreground="White"
                        Background="Transparent"
                        BorderBrush="White"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Command="{Binding SyncCommand}">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Background" Value="White"/>
									<Setter Property="Foreground" Value="#1e293b"/>
								</Trigger>
								<Trigger Property="IsPressed" Value="True">
									<Setter Property="Background" Value="#e2e8f0"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>
				<TextBlock Text="HÁ NOVOS TEMPLATES DISPONÍVEIS NO SERVIDOR"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="13"/>
			</DockPanel>
		</Border>

		<DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,12">
			<Button x:Name="BtnImportar" DockPanel.Dock="Right" Content="IMPORTAR PLANILHA" Width="200" Height="40" Command="{Binding ImportCommand}" />
			<TextBlock DockPanel.Dock="Left" Text="Lista de Invoices" FontSize="20" VerticalAlignment="Center" />
		</DockPanel>

		<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
			<ComboBox ItemsSource="{Binding Batches}" Width="300" Margin="0,0,8,0" SelectedItem="{Binding SelectedBatch}" DisplayMemberPath="Label" />
			<TextBox Width="350" Margin="0,0,8,0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
			<TextBlock VerticalAlignment="Center" Text="{Binding StatTotal}" Margin="8,0" />
		</StackPanel>

		<!-- Borda ajustada para CornerRadius="0" seguindo o design sharp do projeto -->
		<Border Grid.Row="4" BorderBrush="#DDD" BorderThickness="1" CornerRadius="0">
			<DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
				<DataGrid.Columns>
					<!-- NOVA COLUNA: Sequência Matemática Correta -->
					<DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="60" />

					<DataGridTextColumn Header="Invoice" Binding="{Binding Invoice}" Width="150" />
					<DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100" />
					<DataGridTextColumn Header="Descrição ANVISA" Binding="{Binding DescricaoAnvisa}" Width="*" />
					<DataGridTextColumn Header="Lote" Binding="{Binding Lote}" Width="120" />
					<DataGridTextColumn Header="LPN" Binding="{Binding Lpn}" Width="150" />
					<DataGridTemplateColumn Header="Ação" Width="100">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Button Content="Abrir" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>

		<StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
			<StackPanel Orientation="Vertical" Margin="0,0,16,0">
				<TextBlock Text="Total" FontWeight="Bold" />
				<TextBlock Text="{Binding StatTotal}" />
			</StackPanel>
			<StackPanel Orientation="Vertical" Margin="0,0,16,0">
				<TextBlock Text="Vinculados" FontWeight="Bold" />
				<TextBlock Text="{Binding StatVinculados}" />
			</StackPanel>
			<StackPanel Orientation="Vertical" Margin="0,0,16,0">
				<TextBlock Text="Sem arquivo" FontWeight="Bold" />
				<TextBlock Text="{Binding StatSemArquivo}" />
			</StackPanel>
			<StackPanel Orientation="Vertical">
				<TextBlock Text="Importações" FontWeight="Bold" />
				<TextBlock Text="{Binding StatImportacoes}" />
			</StackPanel>
		</StackPanel>
	</Grid>
</UserControl>