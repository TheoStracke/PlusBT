<ui:FluentWindow x:Class="Busca_BT.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:Busca_BT"
                 Title="PlusBT"
                 Icon="pack://application:,,,/favicon.ico"
                 Height="800" Width="1360"
                 MinHeight="600" MinWidth="1000"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="PlusBT — Sistema de Busca de Etiquetas">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/favicon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <DockPanel Margin="12,16">

                    <!-- Versão do app (rodapé, abaixo de tudo) -->
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersaoTexto}" FontSize="11" Opacity="0.5"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>

                    <!-- Atualização baixada do GitHub: instala ao reiniciar (ou na próxima abertura) -->
                    <Border DockPanel.Dock="Bottom" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1"
                            Visibility="{Binding IsAtualizacaoPronta, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding AtualizacaoTexto}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="É instalada ao reiniciar ou na próxima vez que o app abrir."
                                       FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                            <ui:Button Content="Reiniciar e atualizar"
                                       Icon="{ui:SymbolIcon ArrowDownload20}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,8,0,0"
                                       Command="{Binding ReiniciarEAtualizarCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Conexão com o Supabase (rodapé da barra lateral, acima do operador) -->
                    <Border DockPanel.Dock="Bottom" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="{Binding TemOperador, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="6" VerticalAlignment="Center"
                                       Icon="{ui:SymbolIcon ArrowSync20}" ToolTip="Sincronizar agora"
                                       Command="{Binding SincronizarAgoraCommand}"/>
                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="2,0,10,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="{x:Type Ellipse}">
                                        <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSincronizando}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConexaoTexto}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding ConexaoDetalhe}" FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Operador atual (rodapé da barra lateral) -->
                    <Border DockPanel.Dock="Bottom" CornerRadius="8" Padding="10"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="{Binding TemOperador, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,10,0">
                                    <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock Text="{Binding OperadorIniciais}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OperadorNome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding OperadorPerfil}" FontSize="11" Opacity="0.65"/>
                                </StackPanel>
                            </DockPanel>
                            <ui:Button Content="Trocar operador"
                                       Icon="{ui:SymbolIcon PersonSwap20}"
                                       Appearance="Transparent"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,8,0,0"
                                       Command="{Binding TrocarOperadorCommand}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <ui:Button Content="Home"
                                   Icon="{ui:SymbolIcon Home24}"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Height="42" Margin="0,0,0,4"
                                   Command="{Binding ShowHomeCommand}"/>
                        <ui:Button Content="Templates"
                                   Icon="{ui:SymbolIcon DocumentBriefcase24}"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Height="42" Margin="0,0,0,4"
                                   Command="{Binding ShowTemplatesCommand}"
                                   Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ui:Button Content="Histórico"
                                   Icon="{ui:SymbolIcon History24}"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Height="42" Margin="0,0,0,4"
                                   Command="{Binding ShowHistoricoCommand}"/>

                        <Separator Margin="8,12"/>

                        <ui:Button Content="Operadores"
                                   Icon="{ui:SymbolIcon People24}"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Height="42" Margin="0,0,0,4"
                                   Command="{Binding ShowOperadoresCommand}"
                                   Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ui:Button Content="Configurações"
                                   Icon="{ui:SymbolIcon Settings24}"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Height="42" Margin="0,0,0,4"
                                   Command="{Binding ShowSettingsCommand}"
                                   Visibility="{Binding PodeConfigurar, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ui:Button Content="Ajuda"
                                   Icon="{ui:SymbolIcon QuestionCircle24}"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Height="42" Margin="0,0,0,4"
                                   Command="{Binding ShowHelpCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content region -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>

            <!-- "Quem está operando?": cobre a barra lateral e o conteúdo até alguém entrar -->
            <local:OperadorSelecaoView Grid.Column="0" Grid.ColumnSpan="2"
                                       DataContext="{Binding Selecao}"
                                       Visibility="{Binding DataContext.IsSelecaoVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
