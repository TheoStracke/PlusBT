<Window x:Class="Busca_BT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlusBT"
        Icon="pack://application:,,,/favicon.ico"
        Height="720" Width="1280">

    <Window.Resources>
        <Style x:Key="BtnHeaderOutline" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,16" CornerRadius="0">
            <DockPanel LastChildFill="False">
                <!-- Left: Logo/Title -->
                <TextBlock DockPanel.Dock="Left"
                           Text="Sistema de Busca de Etiquetas"
                           FontSize="16" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>

                <!-- Right: Navigation Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Style="{StaticResource BtnHeaderOutline}"
                            Content="HOME"
                            Width="80" Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding ShowHomeCommand}"/>
                    <Button Style="{StaticResource BtnHeaderOutline}"
                            Content="TEMPLATES"
                            Width="110" Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding ShowTemplatesCommand}"/>
                    <Button Style="{StaticResource BtnHeaderOutline}"
                            Content="HISTÓRICO"
                            Width="110" Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding ShowHistoricoCommand}"/>
                    <Button Style="{StaticResource BtnHeaderOutline}"
                            Content="AJUDA"
                            Width="80" Height="32"
                            Command="{Binding ShowHelpCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content region -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>