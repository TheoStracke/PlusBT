<Window x:Class="Busca_BT.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="PlusBT"
        Icon="pack://application:,,,/Busca_BT;component/favicon.ico"
        Width="440" Height="320"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="True">

    <!-- Tela de abertura: aparece logo ao clicar no .exe, enquanto o app
         conecta no banco e carrega a Home. Fecha com fade quando a janela
         principal termina de desenhar. -->
    <Border Margin="16" CornerRadius="12"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Busca_BT;component/BT+.png" Width="72" Height="72"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock Text="PlusBT" FontSize="24" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,14,0,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="Sistema de Busca de Etiquetas" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32" Margin="0,24,0,0"/>

            <TextBlock x:Name="StatusText" Text="Iniciando…" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Border>
</Window>
