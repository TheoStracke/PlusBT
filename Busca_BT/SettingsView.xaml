<UserControl x:Class="Busca_BT.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Configurações de conexão"
                   FontSize="24" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <ui:Card Grid.Row="1" MaxWidth="520" HorizontalAlignment="Left" Padding="24" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Altere o servidor SQL usado por este computador. Não precisa recompilar o app — basta salvar."
                           FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <TextBlock Text="Servidor (IP ou hostname)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock Text="Instância (opcional, ex: SQLEXPRESS)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Instance, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock Text="Banco de dados" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock Text="Usuário" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock Text="Senha" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:PasswordBox x:Name="PasswordBox" Margin="0,0,0,16"/>

                <CheckBox Content="Localizar servidor automaticamente na rede local se a conexão configurada falhar"
                          IsChecked="{Binding AutoDiscover}"
                          FontSize="12" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Testar conexão"
                               Icon="{ui:SymbolIcon PlugConnected24}"
                               Appearance="Secondary"
                               Command="{Binding TestarConexaoCommand}"
                               Margin="0,0,8,0"/>
                    <ui:Button Content="Salvar"
                               Icon="{ui:SymbolIcon Save24}"
                               Appearance="Primary"
                               Command="{Binding SalvarCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusText}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>
