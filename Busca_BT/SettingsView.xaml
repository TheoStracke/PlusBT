<UserControl x:Class="Busca_BT.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Configurações de conexão"
                   FontSize="24" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
        <ui:Card MaxWidth="520" HorizontalAlignment="Left" Padding="24" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Banco de dados na nuvem (Supabase). Os dados ficam no painel do Supabase em Project Settings → Database → Session pooler. A senha é guardada criptografada neste computador."
                           FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <TextBlock Text="Servidor (host)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Porta" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Banco de dados" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Usuário (ex.: postgres.id-do-projeto)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock Text="Senha" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:PasswordBox x:Name="PasswordBox" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Testar conexão"
                               Icon="{ui:SymbolIcon PlugConnected24}"
                               Appearance="Secondary"
                               Command="{Binding TestarConexaoCommand}"
                               Margin="0,0,8,0"/>
                    <ui:Button Content="Salvar"
                               Icon="{ui:SymbolIcon Save24}"
                               Appearance="Primary"
                               Command="{Binding SalvarCommand}"/>
                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="12,0,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusText}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </ui:Card>

        <!-- Templates neste PC -->
        <ui:Card MaxWidth="520" HorizontalAlignment="Left" Padding="24" Margin="0,16,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Templates neste PC" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="De onde este computador abre os arquivos .btw das etiquetas."
                           FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <RadioButton GroupName="ModoTemplates" IsChecked="{Binding ModoBanco}" Margin="0,0,0,4">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Banco de dados (recomendado)" FontWeight="SemiBold"/><LineBreak/>
                        <Run Text="O acervo vem do Supabase e fica copiado neste PC; abre mesmo sem internet." FontSize="12"/>
                    </TextBlock>
                </RadioButton>
                <RadioButton GroupName="ModoTemplates" IsChecked="{Binding ModoPasta}" Margin="0,8,0,8">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Pasta local" FontWeight="SemiBold"/><LineBreak/>
                        <Run Text="Abre direto de uma pasta (deste PC ou da rede). Use como contingência." FontSize="12"/>
                    </TextBlock>
                </RadioButton>

                <DockPanel Margin="28,0,0,16" IsEnabled="{Binding ModoPasta}">
                    <ui:Button DockPanel.Dock="Right" Content="Escolher…" Appearance="Secondary" Margin="8,0,0,0"
                               Command="{Binding EscolherPastaCommand}"/>
                    <ui:TextBox Text="{Binding PastaTemplates, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Ex.: \\Serveradeprint\arquivos\Etiquetas_PlusBT"/>
                </DockPanel>

                <ui:Button Content="Aplicar" Icon="{ui:SymbolIcon Checkmark20}" Appearance="Primary"
                           HorizontalAlignment="Left" Command="{Binding AplicarModoCommand}"/>
                <TextBlock Text="{Binding StatusModo}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ui:Card>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
